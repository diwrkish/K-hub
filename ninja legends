local function createControlButton(text, color, position)
	local button = Instance.new("TextButton")
	button.Size = UDim2.new(0, 34, 0, 34)
	button.Position = position
	button.Text = text
	button.TextColor3 = color
	button.TextSize = 20
	button.TextXAlignment = Enum.TextXAlignment.Center
	button.BackgroundColor3 = Color3.fromRGB(45, 45, 52)
	button.BackgroundTransparency = 0
	button.BorderSizePixel = 0
	button.Parent = TitleBar
	
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 6)
	corner.Parent = button
	
	button.MouseEnter:Connect(function()
		TweenService:Create(button, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(55, 55, 62)}):Play()
	end)
	button.MouseLeave:Connect(function()
		TweenService:Create(button, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(45, 45, 52)}):Play()
	end)
	
	return button
end

