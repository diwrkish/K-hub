local function closeGUI(permanent)
	if permanent then
		TweenService:Create(MainFrame, TweenInfo.new(0.3, Enum.EasingStyle.Quad), {BackgroundTransparency = 1, Size = UDim2.new(0, 540, 0, 50)}):Play()
		task.wait(0.3)
		ScreenGui:Destroy()
	else
		MainFrame.Visible = not MainFrame.Visible
		if MainFrame.Visible then
			TweenService:Create(MainFrame, TweenInfo.new(0.2, Enum.EasingStyle.Quad), {BackgroundTransparency = 0}):Play()
		end
	end
end

