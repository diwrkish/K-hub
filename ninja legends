	local accent = Instance.new("Frame")
	accent.Size = UDim2.new(0.7, 0, 0, 3)
	accent.Position = UDim2.new(0.15, 0, 1, 0)
	accent.BackgroundColor3 = Color3.fromRGB(0, 180, 255)
