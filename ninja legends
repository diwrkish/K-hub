-- Tab Switching
local function switchTab(tab)
	MainContent.Visible = (tab == "Main")
	ConfigContent.Visible = (tab == "Config")
	TeleportContent.Visible = (tab == "Teleport")
	
	local tabs = {
		{btn = MainTabButton, accent = MainAccent},
		{btn = ConfigTabButton, accent = ConfigAccent},
		{btn = TeleportTabButton, accent = TeleportAccent}
	}
	
	for _, t in ipairs(tabs) do
		t.btn.BackgroundTransparency = 0.3
		t.btn.TextColor3 = Color3.fromRGB(150, 150, 165)
		t.accent.BackgroundTransparency = 1
	end
	
	if tab == "Main" then
		MainTabButton.BackgroundTransparency = 0
		MainTabButton.TextColor3 = Color3.fromRGB(255, 255, 255)
		MainAccent.BackgroundTransparency = 0
	elseif tab == "Config" then
		ConfigTabButton.BackgroundTransparency = 0
		ConfigTabButton.TextColor3 = Color3.fromRGB(255, 255, 255)
		ConfigAccent.BackgroundTransparency = 0
	elseif tab == "Teleport" then
		TeleportTabButton.BackgroundTransparency = 0
		TeleportTabButton.TextColor3 = Color3.fromRGB(255, 255, 255)
		TeleportAccent.BackgroundTransparency = 0
	end
end

