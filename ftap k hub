-- ========== CLEAR TOYS FUNCTION ==========
local function clearAllToys()
    local folder = workspace:FindFirstChild("BLOX_FRUIT01110SpawnedInToys")
    if folder then
        for _, child in ipairs(folder:GetChildren()) do
            pcall(function() child:Destroy() end)
        end
    end
    
    pcall(function()
        local menuGui = player.PlayerGui:FindFirstChild("MenuGui")
        if menuGui then
            local menu = menuGui:FindFirstChild("Menu")
            if menu then
                local tabContents = menu:FindFirstChild("TabContents")
                if tabContents then
                    local toyDestroy = tabContents:FindFirstChild("ToyDestroy")
                    if toyDestroy then
                        local meterFrame = toyDestroy:FindFirstChild("MeterFrame")
                        if meterFrame then
                            local spaceUsedNumbers = meterFrame:FindFirstChild("SpaceUsedNumbers")
                            if spaceUsedNumbers and spaceUsedNumbers:IsA("TextLabel") then
                                spaceUsedNumbers.Text = "0/100"
                            end
                        end
                    end
                end
            end
        end
    end)
end

-- ========== E + CLICK + E SEQUENCE ==========
local function doAction()
    if not enabled or isExecuting then return end
    isExecuting = true
    
    vim:SendKeyEvent(true, Enum.KeyCode.E, false, nil)
    task.wait(settings.delays.openMenuPress)
    vim:SendKeyEvent(false, Enum.KeyCode.E, false, nil)
    
    task.wait(settings.delays.menuOpenWait)
    
    vim:SendMouseButtonEvent(settings.clickX, settings.clickY, 0, true, nil, 0)
    task.wait(settings.delays.clickHold)
    vim:SendMouseButtonEvent(settings.clickX, settings.clickY, 0, false, nil, 0)
    
    task.wait(settings.delays.postClickWait)
    
    vim:SendKeyEvent(true, Enum.KeyCode.E, false, nil)
    task.wait(settings.delays.closeMenuPress)
    vim:SendKeyEvent(false, Enum.KeyCode.E, false, nil)
    
    isExecuting = false
end

