-- ========== GLOBAL MOUSE CLICK CAPTURE FOR COORDINATE PICKER ==========
inputConnection = uis.InputBegan:Connect(function(input, gameProcessed)
    if waitingForCoordinateClick and input.UserInputType == Enum.UserInputType.MouseButton1 then
        local mousePos = uis:GetMouseLocation()
        settings.clickX = mousePos.X
        settings.clickY = mousePos.Y
        updateDoActionBtnText()
        setPosBtn.Text = "🎯 Set Click Position (Click anywhere)"
        setPosBtn.BackgroundColor3 = Color3.fromRGB(100, 30, 150)
        waitingForCoordinateClick = false
        return
    end
    
    if gameProcessed then return end
    if not enabled then return end
    
    if rebindingKey and input.KeyCode ~= Enum.KeyCode.Unknown then
        settings.keybinds[rebindingKey] = input.KeyCode
        for _, field in ipairs(keybindFields) do
            if field.action == rebindingKey then
                field.keyDisplay.Text = input.KeyCode.Name
                field.changeBtn.Text = "Change"
                break
            end
        end
        rebindingKey = nil
        return
    end
    
    if input.KeyCode == settings.keybinds.execute then
        doAction()
    elseif input.KeyCode == settings.keybinds.disable then
        disableAndCleanup()
    elseif input.KeyCode == settings.keybinds.toggleMenu then
        toggleMenu()
    elseif input.KeyCode == settings.keybinds.clearToys then
        clearAllToys()
    end
end)

closeBtn.MouseButton1Click:Connect(function()
    menuOpen = false
    mainFrame.Visible = false
    lockMouse()
end)

-- ========== CORE FUNCTIONS ==========
function disableAndCleanup()
    enabled = false
    menuOpen = false
    mainFrame.Visible = false
    lockMouse()
    
    if inputConnection then
        inputConnection:Disconnect()
        inputConnection = nil
    end
    
    if screenGui and screenGui.Parent then
        screenGui:Destroy()
    end
    
    print("⛔ Script fully disabled, all code stopped, UI removed.")
end

function toggleMenu()
    menuOpen = not menuOpen
    mainFrame.Visible = menuOpen
    if menuOpen then
        unlockMouse()
    else
        lockMouse()
    end
end

