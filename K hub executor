-- Drag, resize, minimize logic
local dragging = false
local dragStartPos, frameStartPos
local resizing = false
local resizeStartSize, resizeStartMousePos
local minSize = Vector2.new(300, 300)

local function startDrag(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		local pos = input.Position
		if TitleBar.AbsolutePosition.X <= pos.X and pos.X <= TitleBar.AbsolutePosition.X + TitleBar.AbsoluteSize.X
			and TitleBar.AbsolutePosition.Y <= pos.Y and pos.Y <= TitleBar.AbsolutePosition.Y + TitleBar.AbsoluteSize.Y then
			dragging = true
			dragStartPos = pos
			frameStartPos = MainFrame.Position
			input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then dragging = false end
			end)
		end
	end
end

local function onDrag(input)
	if dragging then
		local delta = input.Position - dragStartPos
		MainFrame.Position = UDim2.new(
			frameStartPos.X.Scale,
			frameStartPos.X.Offset + delta.X,
			frameStartPos.Y.Scale,
			frameStartPos.Y.Offset + delta.Y
		)
	end
end

local ResizeHandle = Instance.new("TextButton")
ResizeHandle.Parent = MainFrame
ResizeHandle.BackgroundColor3 = Color3.fromRGB(100, 100, 100)
ResizeHandle.BorderSizePixel = 0
ResizeHandle.Size = UDim2.new(0, 20, 0, 20)
ResizeHandle.Position = UDim2.new(1, -20, 1, -20)
ResizeHandle.Text = ""
ResizeHandle.AutoButtonColor = false
ResizeHandle.ZIndex = 2

local function startResize(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		local pos = input.Position
		local hPos = ResizeHandle.AbsolutePosition
		local hSize = ResizeHandle.AbsoluteSize
		if pos.X >= hPos.X and pos.X <= hPos.X + hSize.X and pos.Y >= hPos.Y and pos.Y <= hPos.Y + hSize.Y then
			resizing = true
			resizeStartMousePos = pos
			resizeStartSize = MainFrame.AbsoluteSize
			input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then resizing = false end
			end)
		end
	end
end

local function onResize(input)
	if resizing then
		local delta = input.Position - resizeStartMousePos
		local newW = math.max(minSize.X, resizeStartSize.X + delta.X)
		local newH = math.max(minSize.Y, resizeStartSize.Y + delta.Y)
		MainFrame.Size = UDim2.new(0, newW, 0, newH)
	end
end

MainFrame.InputBegan:Connect(function(input)
	startDrag(input)
	startResize(input)
end)
UserInputService.InputChanged:Connect(function(input)
	onDrag(input)
	onResize(input)
end)
UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		dragging = false
		resizing = false
	end
end)

-- Minimize/Maximize
local minimized = false
local normalSize, normalPosition
MinimizeButton.MouseButton1Click:Connect(function()
	if not minimized then
		normalSize = MainFrame.Size
		normalPosition = MainFrame.Position
		MainFrame.Size = UDim2.new(0, 250, 0, 30)
		ContentFrame.Visible = false
		KeybindFrame.Visible = false
		ResizeHandle.Visible = false
		ScriptsTab.Visible = false
		minimized = true
	else
		MainFrame.Size = normalSize
		MainFrame.Position = normalPosition
		ContentFrame.Visible = true
		KeybindFrame.Visible = true
		ResizeHandle.Visible = true
		ScriptsTab.Visible = true
		minimized = false
	end
end)

-- Toggle UI with keybind
local isOpen = true
local toggleKey = Enum.KeyCode.RightShift

local function toggleUI()
	isOpen = not isOpen
	MainFrame.Visible = isOpen
end

CloseButton.MouseButton1Click:Connect(function()
	MainFrame.Visible = false
	isOpen = false
end)

UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if gameProcessed then return end
	if input.KeyCode == toggleKey then
		toggleUI()
	end
end)

-- Change keybind
local waitingForKey = false
ChangeBindButton.MouseButton1Click:Connect(function()
	waitingForKey = true
	CurrentKeybind.Text = "..."
end)

UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if waitingForKey and not gameProcessed then
		if input.KeyCode ~= Enum.KeyCode.Unknown then
			toggleKey = input.KeyCode
			CurrentKeybind.Text = input.KeyCode.Name
			waitingForKey = false
		end
	end
end)

